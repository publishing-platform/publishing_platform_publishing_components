  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#edition-2" aria-expanded="false" aria-controls="edition-2">
        Edition 2
      </button>
    </h2>
    <div id="edition-2" class="accordion-collapse collapse" data-bs-parent="#edition-history">
      <div class="accordion-body">
        History of second version of Edition
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#edition-3" aria-expanded="false" aria-controls="edition-3">
        Edition 3
      </button>
    </h2>
    <div id="edition-3" class="accordion-collapse collapse" data-bs-parent="#edition-history">
      <div class="accordion-body">
        History of third version of Edition
      </div>
    </div>
  </div>
</div>