<h1>A test page in the dummy app</h1>
<p>This is for testing the accordion component</p>

<div class="accordion" id="edition-history">
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#edition-1" aria-expanded="true" aria-controls="edition-1">
